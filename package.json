{
  "name": "risheh-website-template-factory",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.mjs tests/c1/*.test.ts",
    "validate": "node scripts/validate-factory.mjs",
    "quality": "node scripts/check-quality-gates.mjs",
    "catalog": "node scripts/build-catalog.mjs",
    "codegen:compat": "tsx scripts/codegen/check-all-archetypes.mjs",
    "codegen:fixtures": "tsx scripts/codegen/generate-fixture-projects.mjs",
    "codegen:fixtures:quality": "for d in .generated/fixtures/*; do tsx scripts/codegen/check-generated-project.mjs \"$d\" || exit 1; done",
    "codegen:forbidden": "tsx scripts/codegen/forbidden-content.mjs .generated/fixtures",
    "codegen:check": "npm run codegen:compat && npm run codegen:fixtures && npm run codegen:fixtures:quality && npm run codegen:forbidden",
    "check": "npm run validate && npm run quality && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {"node": ">=20"}
}
