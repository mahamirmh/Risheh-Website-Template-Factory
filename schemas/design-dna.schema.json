{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"risheh.design-dna.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","id","version","name","tokens","layout","geometry","imagery","motion","interaction_density","content_density","accessibility","suitable_industries","unsuitable_industries","prohibited_patterns"],
  "properties":{
    "schema":{"const":"risheh.design-dna.v1"},
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version":{"type":"string","pattern":"^\\d+\\.\\d+\\.\\d+$"},
    "name":{"type":"string","minLength":1},
    "tokens":{"type":"object","required":["typography","spacing"],"properties":{"typography":{"type":"object"},"spacing":{"type":"object"},"color_strategy":{"type":"string"}}},
    "layout":{"type":"object","required":["max_width_strategy","section_rhythm"],"properties":{"max_width_strategy":{"type":"string"},"section_rhythm":{"type":"string"},"grid":{"type":"string"}}},
    "geometry":{"type":"object","required":["radius","border","shadow"],"properties":{"radius":{"type":"string"},"border":{"type":"string"},"shadow":{"type":"string"}}},
    "imagery":{"type":"object","required":["treatment"],"properties":{"treatment":{"type":"string"},"preferred_ratios":{"type":"array","items":{"type":"string"}}}},
    "motion":{"type":"object","required":["intensity","reduced_motion"],"properties":{"intensity":{"enum":["none","low","medium","high"]},"reduced_motion":{"type":"string"}}},
    "interaction_density":{"enum":["low","medium","high"]},
    "content_density":{"enum":["low","medium","high"]},
    "accessibility":{"type":"array","minItems":1,"items":{"type":"string"}},
    "suitable_industries":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "unsuitable_industries":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "prohibited_patterns":{"type":"array","items":{"type":"string"},"uniqueItems":true}
  }
}