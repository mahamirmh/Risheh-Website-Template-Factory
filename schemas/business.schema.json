{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "risheh.business.v1",
  "title": "Risheh Business Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "brand", "business", "content", "locale", "goals", "implementation"],
  "properties": {
    "schema": {"const": "risheh.business.v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "personality"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "logo": {"type": ["string", "null"]},
        "primary_color": {"type": ["string", "null"]},
        "secondary_color": {"type": ["string", "null"]},
        "accent_color": {"type": ["string", "null"]},
        "font_family": {"type": ["string", "null"]},
        "personality": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "business": {
      "type": "object",
      "additionalProperties": false,
      "required": ["industry", "audience", "positioning"],
      "properties": {
        "industry": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "subcategory": {"type": ["string", "null"]},
        "audience": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "positioning": {"type": "string", "minLength": 1},
        "services": {"type": "array", "items": {"type": "string"}},
        "products": {"type": "array", "items": {"type": "string"}}
      }
    },
    "content": {
      "type": "object",
      "required": ["hero_title"],
      "properties": {
        "hero_title": {"type": "string", "minLength": 1},
        "hero_subtitle": {"type": ["string", "null"]},
        "primary_cta": {"type": ["string", "null"]},
        "secondary_cta": {"type": ["string", "null"]},
        "social_proof": {"type": "array"},
        "faq": {"type": "array"}
      }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "direction", "country"],
      "properties": {
        "language": {"type": "string", "minLength": 2},
        "direction": {"enum": ["rtl", "ltr"]},
        "country": {"type": "string", "minLength": 2}
      }
    },
    "goals": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "secondary": {"type": "array", "items": {"type": "string"}}
      }
    },
    "implementation": {
      "type": "object",
      "required": ["framework", "language", "styling"],
      "properties": {
        "framework": {"type": "string"},
        "language": {"type": "string"},
        "styling": {"type": "string"}
      }
    }
  }
}